apiVersion: v1
kind: ConfigMap
metadata:
    annotations:
        argocd.argoproj.io/sync-wave: "-1"
    name: absa-ac-config
    namespace: absa-ac-dev
data:
    DISCORD_TOKEN: REPLACE_WITH_DISCORD_BOT_TOKEN
    CHANNEL_ID: REPLACE_WITH_DISCORD_CHANNEL_ID
    SERVER_IP: REPLACE_WITH_GAME_SERVER_IP
    API_ENABLED: "true"
    API_PORT: "REPLACE_WITH_API_PORT"
    PROXY_ENABLED: "false"
    PROXY_USER: REPLACE_WITH_PROXY_USER
    PROXY_PASSWORD: REPLACE_WITH_PROXY_PASSWORD
    PROXY_PORT: REPLACE_WITH_PROXY_PORT
    API_BEARER_TOKEN: REPLACE_WITH_API_BEARER_TOKEN
    API_CORS_ORIGINS: REPLACE_WITH_CORS_ORIGINS
    ALLOW_CORS_ANY: "false"
